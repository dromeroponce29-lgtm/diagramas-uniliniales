# Copiar a .env y completar con claves reales (nunca commitear .env).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Puerto del servidor.
# - En desarrollo local usa PUERTO (default 3001).
# - En Render (producción) la plataforma inyecta PORT automáticamente y tiene prioridad.
PUERTO=3001

# Modelo de Claude a usar para extracción y reconciliación.
# claude-opus-4-7 (1M context) es el más capaz al momento del Plan 1.
CLAUDE_MODEL=claude-opus-4-7

# Modelo OpenAI para extracción.
OPENAI_MODEL=gpt-4o

# Orígenes permitidos por CORS (separados por comas).
# Si está vacío o sin setear, el default es:
#   http://localhost:5173,https://unilineales.tecnofitness.cl
ORIGENES_PERMITIDOS=http://localhost:5173,https://unilineales.tecnofitness.cl

# Directorio raíz donde se almacenan los proyectos/clientes/tableros.
# - Local: dejar vacío para usar ./proyectos relativo al cwd.
# - Render: setear a /data/proyectos (disco persistente montado en /data).
DIRECTORIO_PROYECTOS=
