# =============================================================================
# AEP-Eléctrico — Variables de entorno
# =============================================================================
# Copiar este archivo a .env y completar los valores reales.
# IMPORTANTE: nunca commitear .env al repositorio.

# ===== Base de datos =====
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=aep
POSTGRES_PASSWORD=cambiame_a_algo_seguro
POSTGRES_DB=aep_electrico

# ===== Redis (Celery) =====
REDIS_URL=redis://redis:6379/0

# ===== Anthropic (Claude) =====
# Obtener clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-aqui-tu-clave
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096

# ===== Voyage AI (embeddings para RAG) =====
# Obtener clave en https://dash.voyageai.com/
# Si no se configura, el RAG cae a búsqueda por similitud de texto (sin embeddings)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large

# ===== Almacenamiento =====
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=100

# ===== CORS =====
CORS_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ===== App =====
DEBUG=false
LOG_LEVEL=INFO

# ===== RAG =====
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RAG_TOP_K=20
RAG_RERANK_TOP=5
